# Copy this file to .env and fill in real values. .env is git-ignored and must never be committed.
# Every value below has a safe development default, so Docker runs even without a .env file.

# --- Database (used by docker-compose for the PostgreSQL container) ---
POSTGRES_USER=speakquest
POSTGRES_PASSWORD=speakquest
POSTGRES_DB=speakquest

# Host port for the PostgreSQL container (5433 avoids clashing with a local PostgreSQL)
POSTGRES_PORT=5433

# Only needed when running the API outside Docker (docker-compose builds its own URL)
DATABASE_URL=postgresql+psycopg://speakquest:speakquest@localhost:5433/speakquest

# --- Environment ---
# development: an unsafe SECRET_KEY below only logs a warning. Any other value (e.g. production)
# refuses to start until SECRET_KEY is a real secret of at least 32 characters.
ENVIRONMENT=development

# --- Security ---
# Signs every login token: anyone who knows it can log in as anyone. Replace the example value with
# a random one before using the game anywhere but your own machine. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# How long a login stays valid, in minutes (default: one day)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider (see docs/decisions/0001-ai-provider.md) ---
# AI_PROVIDER: only "gemini" is implemented. Leave AI_PROVIDER or AI_API_KEY empty and the game
# still runs: NPCs answer with a safe fallback line and nothing in the game changes.
# AI_API_KEY is the key for that provider only (Gemini: https://aistudio.google.com/apikey).
# The key lives in your own .env, never in the frontend and never in a commit.
AI_PROVIDER=
AI_API_KEY=
# Model names are retired quickly, so keep it a setting. Empty uses the default (gemini-3.1-flash-lite).
AI_MODEL=
# Seconds to wait for one AI call; a timeout is retried once
AI_TIMEOUT_SECONDS=20

# --- Request limits (in-memory, per API process) ---
# Dialogue messages one player may send within the window; protects the AI quota
DIALOGUE_RATE_LIMIT=10
DIALOGUE_RATE_WINDOW_SECONDS=60

# Failed logins allowed per email + IP within the window; after that the API answers 429 with
# a Retry-After header. A successful login resets the counter.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
# Registration attempts allowed per IP within the window
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=60
# Wrong current passwords allowed per account within the window when changing the password or
# deleting the account; after that the API answers 429 with a Retry-After header
PASSWORD_CHECK_RATE_LIMIT=5
PASSWORD_CHECK_RATE_WINDOW_SECONDS=900
