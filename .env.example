# Copy this file to .env and fill in real values. .env is git-ignored and must never be committed.
# Every value below has a safe development default, so Docker runs even without a .env file.

# --- Database (used by docker-compose for the PostgreSQL container) ---
POSTGRES_USER=speakquest
POSTGRES_PASSWORD=speakquest
POSTGRES_DB=speakquest

# Host port for the PostgreSQL container (5433 avoids clashing with a local PostgreSQL)
POSTGRES_PORT=5433

# Only needed when running the API outside Docker (docker-compose builds its own URL)
DATABASE_URL=postgresql+psycopg://speakquest:speakquest@localhost:5433/speakquest

# --- Security ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# How long a login stays valid, in minutes (default: one day)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider (see docs/decisions/0001-ai-provider.md) ---
# AI_PROVIDER is gemini or openai. AI_API_KEY is the key for that provider only.
# The key lives in your own .env, never in the frontend and never in a commit.
AI_PROVIDER=
AI_API_KEY=
